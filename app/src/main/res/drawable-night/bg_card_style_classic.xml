<?xml version="1.0" encoding="utf-8"?>
<!-- ডার্ক মোড ওভাররাইড — আগে cardWhite (#FFFFFF) সরাসরি ব্যবহার হতো, তাই ডার্ক মোডে
     সাদা কার্ডের উপর হালকা টেক্সট কালার (textPrimary/textSecondary) বসে অদৃশ্য হয়ে যেত।
     এখন ডার্ক-থিমের cardBg ব্যবহার করা হচ্ছে যাতে লেখা স্পষ্ট বোঝা যায়। -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/cardBg"/>
    <corners android:radius="16dp"/>
    <stroke android:width="1.2dp" android:color="@color/personCardBorder"/>
</shape>
