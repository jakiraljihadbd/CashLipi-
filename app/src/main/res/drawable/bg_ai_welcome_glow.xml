<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <solid android:color="#1F00D4FF"/>
        </shape>
    </item>
    <item android:top="10dp" android:bottom="10dp" android:left="10dp" android:right="10dp">
        <shape android:shape="oval">
            <solid android:color="#3300D4FF"/>
        </shape>
    </item>
    <item android:top="22dp" android:bottom="22dp" android:left="22dp" android:right="22dp">
        <shape android:shape="oval">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="@color/aiBotAvatarStart"
                android:endColor="@color/aiBotAvatarEnd"/>
        </shape>
    </item>
</layer-list>
