<?xml version="1.0" encoding="utf-8"?>
<!-- FIX: আগের ফিকে pastel সলিড কালার (m3ExpenseContainer)-এর বদলে আকর্ষণীয় গ্র্যাডিয়েন্ট। -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#EF4444"
                android:centerColor="#F0555A"
                android:endColor="#F87171"
                android:angle="135"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:bottom="90dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" android:angle="270"/>
            <corners android:topLeftRadius="24dp" android:topRightRadius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1F000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
