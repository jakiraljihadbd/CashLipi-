<?xml version="1.0" encoding="utf-8"?>
<!-- FIX: আগের ফিকে pastel সলিড কালার (m3SavingsContainer)-এর বদলে আকর্ষণীয় বেগুনি-গোলাপি গ্র্যাডিয়েন্ট,
     ডার্ক মোডের সঞ্চয় কার্ডের সাথে সামঞ্জস্যপূর্ণ। -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#8B5CF6"
                android:centerColor="#B054C7"
                android:endColor="#EC4899"
                android:angle="135"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item android:bottom="52dp">
        <shape android:shape="rectangle">
            <gradient android:startColor="#26FFFFFF" android:endColor="#00FFFFFF" android:angle="270"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1F000000"/>
            <corners android:radius="24dp"/>
        </shape>
    </item>
</layer-list>
