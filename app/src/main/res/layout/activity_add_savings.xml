<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/appBg">
    <androidx.core.widget.NestedScrollView android:layout_width="match_parent"
        android:layout_height="match_parent" android:overScrollMode="never"
        android:paddingBottom="28dp" android:clipToPadding="false">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ===== হেডার — বড়, গ্রেডিয়েন্ট, আইকনসহ ===== -->
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_header_savings" android:orientation="vertical"
                android:paddingTop="20dp" android:paddingBottom="22dp" android:paddingHorizontal="20dp"
                android:elevation="6dp">

                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="horizontal" android:gravity="center_vertical">
                    <LinearLayout android:layout_width="46dp" android:layout_height="46dp"
                        android:background="@drawable/ie_summary_icon_income" android:gravity="center"
                        android:layout_marginEnd="12dp">
                        <ImageView android:layout_width="26dp" android:layout_height="26dp"
                            android:src="@drawable/ic_nav_savings" android:scaleType="centerInside"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                        android:layout_weight="1" android:orientation="vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="নতুন সঞ্চয় যোগ করুন" android:textSize="19sp" android:textStyle="bold"
                            android:textColor="@color/white"/>
                        <TextView android:id="@+id/tvCurrentBalance" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="মোট সঞ্চয়: ৳ 0"
                            android:textSize="14sp" android:textStyle="bold" android:textColor="@color/white" android:alpha="0.92"
                            android:layout_marginTop="3dp"/>
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- ===== ফর্ম কার্ড ===== -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:layout_marginTop="16dp"
                app:cardCornerRadius="18dp" app:cardElevation="4dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="18dp">

                    <!-- পেমেন্টের মাধ্যম — বড়, ব্র্যান্ড-কালার আইকন চিপ (বিকাশ/নগদ/রকেট ইত্যাদি) -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="সঞ্চয়ের মাধ্যম" android:textSize="15sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/textPrimary" android:layout_marginBottom="10dp"/>

                    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:scrollbars="none" android:clipToPadding="false"
                        android:layout_marginBottom="16dp">
                        <LinearLayout android:id="@+id/rowPaymentMethods"
                            android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:orientation="horizontal"/>
                    </HorizontalScrollView>

                    <LinearLayout android:id="@+id/bankNameRow" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:orientation="vertical"
                        android:visibility="gone" android:layout_marginBottom="14dp">
                        <com.google.android.material.textfield.TextInputLayout style="@style/AppTextInputSmooth.Savings"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:hint="ব্যাংকের নাম (যেমন: ডাচ বাংলা)">
                            <com.google.android.material.textfield.TextInputEditText android:id="@+id/etBankName"
                                android:layout_width="match_parent" android:layout_height="wrap_content"
                                android:inputType="textCapWords" android:textSize="15sp"
                                android:paddingVertical="14dp"/>
                        </com.google.android.material.textfield.TextInputLayout>
                    </LinearLayout>

                    <!-- পরিমাণ — বড়, স্পষ্ট -->
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                        android:text="পরিমাণ (৳)" android:textSize="15sp" android:textStyle="bold"
                        android:fontFamily="sans-serif-black"
                        android:textColor="@color/textPrimary" android:layout_marginBottom="10dp"/>
                    <com.google.android.material.textfield.TextInputLayout android:id="@+id/tilAmount"
                        style="@style/AppTextInputSmooth.Savings" android:layout_width="match_parent"
                        android:layout_height="wrap_content" android:hint="পরিমাণ লিখুন" android:layout_marginBottom="12dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etAmount"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="numberDecimal" android:textSize="24sp" android:textStyle="bold"
                            android:paddingVertical="16dp"
                            android:textColor="@color/savingsColor"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <!-- কুইক অ্যামাউন্ট — বড়, টাচ-ফ্রেন্ডলি গ্রিড -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="8dp">
                        <Button android:id="@+id/btn100" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳৫" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn500" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳১০" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn1000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳২০" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn2000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳৫০"/>
                    </LinearLayout>
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="18dp">
                        <Button android:id="@+id/btn5000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳১০০" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn10000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳২০০" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn20000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳৫০০" android:layout_marginEnd="6dp"/>
                        <Button android:id="@+id/btn50000" style="@style/QuickAmountBtn.Savings"
                            android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:text="৳১০০০"/>
                    </LinearLayout>

                    <!-- তারিখ / সময় — বড়, আইকনসহ -->
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:layout_marginBottom="16dp">
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginEnd="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="তারিখ" android:textSize="13sp" android:textStyle="bold"
                                android:textColor="@color/textPrimary" android:layout_marginBottom="8dp"/>
                            <LinearLayout android:id="@+id/tvDate" android:layout_width="match_parent"
                                android:layout_height="56dp" android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp" android:background="@drawable/bg_field_savings"
                                android:clickable="true" android:focusable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                    android:src="@drawable/ic_calendar" app:tint="@color/iePinkBright"
                                    android:layout_marginEnd="10dp"/>
                                <TextView android:id="@+id/tvDateText" android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textPrimary"/>
                            </LinearLayout>
                        </LinearLayout>
                        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                            android:layout_weight="1" android:orientation="vertical" android:layout_marginStart="6dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                                android:text="সময়" android:textSize="13sp" android:textStyle="bold"
                                android:textColor="@color/textPrimary" android:layout_marginBottom="8dp"/>
                            <LinearLayout android:id="@+id/tvTime" android:layout_width="match_parent"
                                android:layout_height="56dp" android:gravity="center_vertical"
                                android:orientation="horizontal"
                                android:paddingHorizontal="14dp" android:background="@drawable/bg_field_savings"
                                android:clickable="true" android:focusable="true">
                                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                                    android:src="@drawable/ic_clock" app:tint="@color/iePinkBright"
                                    android:layout_marginEnd="10dp"/>
                                <TextView android:id="@+id/tvTimeText" android:layout_width="0dp"
                                    android:layout_height="wrap_content" android:layout_weight="1"
                                    android:textSize="14sp" android:textStyle="bold" android:textColor="@color/textPrimary"/>
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout style="@style/AppTextInputSmooth.Savings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:hint="নোট (ঐচ্ছিক)" android:layout_marginBottom="20dp">
                        <com.google.android.material.textfield.TextInputEditText android:id="@+id/etNote"
                            android:layout_width="match_parent" android:layout_height="wrap_content"
                            android:inputType="textMultiLine" android:minLines="2" android:gravity="top"
                            android:textSize="14.5sp" android:paddingVertical="14dp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button android:id="@+id/btnSaveSavings" style="@style/SubmitButton.Savings"
                        android:layout_width="match_parent" android:layout_height="58dp"
                        android:text="সঞ্চয় সংরক্ষণ করুন" android:textColor="@color/white"
                        android:textSize="17sp" android:textStyle="bold"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Recent Savings Card -->
            <androidx.cardview.widget.CardView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginHorizontal="12dp" android:layout_marginTop="14dp" android:layout_marginBottom="20dp"
                app:cardCornerRadius="18dp" app:cardElevation="2dp" app:cardBackgroundColor="@color/white">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                    android:orientation="vertical" android:padding="16dp">
                    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="10dp">
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                            android:text="সর্বশেষ সঞ্চয় (৫টি)" android:textSize="14sp" android:textStyle="bold"
                            android:textColor="@color/textPrimary"/>
                        <TextView android:id="@+id/tvViewAllSavings" android:layout_width="wrap_content"
                            android:layout_height="wrap_content" android:text="সব দেখুন →"
                            android:textSize="13sp" android:textStyle="bold" android:textColor="@color/savingsColor"
                            android:padding="4dp"
                            android:clickable="true" android:focusable="true"/>
                    </LinearLayout>
                    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvRecentSavings"
                        android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"/>
                    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
                        android:layout_height="60dp" android:gravity="center" android:visibility="gone">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                            android:text="কোনো সঞ্চয় নেই" android:textSize="13sp" android:textColor="@color/textSecondary"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
