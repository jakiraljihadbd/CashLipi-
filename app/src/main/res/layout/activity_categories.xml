<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bgColor">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:overScrollMode="never"
        android:paddingBottom="28dp"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- ═══════════════════════════════════════════
                 হেডার — অ্যাপের স্ট্যান্ডার্ড পিংক, চিকন, একদম সোজা (কোনো বাঁক নেই)
                 ═══════════════════════════════════════════ -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_header_flat_pink"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="6dp"
                android:paddingTop="10dp"
                android:paddingBottom="12dp">

                <ImageView
                    android:id="@+id/btnBack"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:padding="9dp"
                    android:src="@drawable/ic_arrow_back"
                    app:tint="@color/white"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:clickable="true"
                    android:focusable="true"/>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:layout_marginStart="4dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="স্থায়ী ক্যাটাগরি"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"/>

                    <TextView
                        android:id="@+id/tvCategoryCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="মোট ০টি ক্যাটাগরি"
                        android:textSize="11.5sp"
                        android:textColor="@color/white"
                        android:alpha="0.85"
                        android:layout_marginTop="1dp"/>
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="14dp">

                <!-- ═══════════════════════════════════════════
                     আয়/ব্যয় টগল — আয়-ব্যয় পেজের মতোই সবুজ/লাল স্টাইল
                     ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:layout_marginTop="16dp"
                    android:orientation="horizontal"
                    android:background="@drawable/ie_view_tab_track"
                    android:padding="4dp"
                    android:elevation="2dp">

                    <TextView
                        android:id="@+id/btnTypeIncome"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="আয়ের ক্যাটাগরি"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:clickable="true"
                        android:focusable="true"/>

                    <TextView
                        android:id="@+id/btnTypeExpense"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="4dp"
                        android:gravity="center"
                        android:text="ব্যয়ের ক্যাটাগরি"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textAllCaps="false"
                        android:clickable="true"
                        android:focusable="true"/>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════
                     নতুন ক্যাটাগরি যোগ করুন — প্রধান, স্পষ্ট, সহজ
                     ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:id="@+id/addCategoryCard"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_card_square"
                    android:padding="16dp"
                    android:layout_marginTop="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageView
                            android:id="@+id/ivAddCategoryIcon"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:padding="9dp"
                            android:background="@drawable/bg_icon_circle_income"
                            android:src="@drawable/ic_plus_circle"
                            app:tint="@color/white"/>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_marginStart="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="নতুন ক্যাটাগরি যোগ করুন"
                                android:textSize="15.5sp"
                                android:textStyle="bold"
                                android:textColor="@color/textPrimary"/>

                            <TextView
                                android:id="@+id/tvAddCategorySubtitle"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="আয়ের একটি নতুন খাতের নাম লিখুন"
                                android:textSize="12sp"
                                android:textColor="@color/textSecondary"
                                android:layout_marginTop="1dp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/tilNewCategory"
                        style="@style/AppTextInputSmooth.Adaptive"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        app:startIconDrawable="@drawable/ic_tag"
                        app:boxCornerRadiusTopStart="18dp"
                        app:boxCornerRadiusTopEnd="18dp"
                        app:boxCornerRadiusBottomStart="18dp"
                        app:boxCornerRadiusBottomEnd="18dp"
                        app:boxStrokeWidthFocused="2dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etNewCategory"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:paddingVertical="14dp"
                            android:inputType="textCapSentences"
                            android:maxLines="1"
                            android:imeOptions="actionDone"
                            android:textSize="15.5sp"
                            android:textStyle="bold"
                            android:textColor="@color/textPrimary"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <Button
                        android:id="@+id/btnAddCategory"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="12dp"
                        android:text="＋ ক্যাটাগরি যোগ করুন"
                        android:textAllCaps="false"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/white"
                        android:background="@drawable/bg_add_cat_btn_income"
                        android:elevation="0dp"
                        android:stateListAnimator="@null"/>
                </LinearLayout>

                <!-- ═══════════════════════════════════════════
                     বিদ্যমান ক্যাটাগরি তালিকা
                     ═══════════════════════════════════════════ -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="22dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="বিদ্যমান ক্যাটাগরি"
                        android:textSize="14.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/textPrimary"/>

                    <TextView
                        android:id="@+id/tvListHint"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="সম্পাদনা করতে ✏️ চাপুন"
                        android:textSize="11sp"
                        android:textColor="@color/textHint"/>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/categoryContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>

                <!-- ===== খালি অবস্থা ===== -->
                <LinearLayout
                    android:id="@+id/emptyState"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:paddingVertical="36dp"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🗂️"
                        android:textSize="40sp"/>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="এখনো কোনো ক্যাটাগরি যোগ করা হয়নি"
                        android:textSize="13.5sp"
                        android:textStyle="bold"
                        android:textColor="@color/textSecondary"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
