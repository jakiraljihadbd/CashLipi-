<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/appBg">

    <!-- Header with modern gradient background -->
    <LinearLayout android:id="@+id/listHeader" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:background="@drawable/bg_header_savings"
        android:orientation="vertical" android:paddingTop="16dp"
        android:paddingBottom="18dp" android:paddingHorizontal="16dp"
        android:elevation="6dp">

        <!-- Title + Add Button -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:layout_marginBottom="12dp">
            <TextView android:id="@+id/tvListHeader" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:text="সঞ্চয় তালিকা"
                android:textSize="21sp" android:textStyle="bold" android:textColor="@color/white"
                android:fontFamily="sans-serif-medium"/>
            <LinearLayout android:id="@+id/btnAddNew" android:layout_width="42dp" android:layout_height="42dp"
                android:background="@drawable/bg_summary_glass"
                android:gravity="center"
                android:layout_marginStart="12dp"
                android:elevation="3dp"
                android:clickable="true" android:focusable="true">
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="+" android:textSize="24sp" android:textStyle="bold"
                    android:textColor="@color/white"/>
            </LinearLayout>
        </LinearLayout>

        <!-- Summary Cards Row (এখন দুটি কার্ড) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical"
            android:layout_marginBottom="0dp">
            
            <!-- Total Amount Card -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/bg_summary_glass" android:padding="12dp"
                android:layout_marginEnd="6dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মোট সঞ্চয়"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/white" android:alpha="0.85"/>
                <TextView android:id="@+id/tvSummaryTotal" android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="৳ 0" android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/white" android:fontFamily="sans-serif-medium"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
            
            <!-- Entry Count Card -->
            <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:orientation="vertical"
                android:background="@drawable/bg_summary_glass" android:padding="12dp"
                android:layout_marginStart="6dp" android:elevation="2dp">
                <TextView android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মোট এন্ট্রি"
                    android:textSize="10.5sp" android:textStyle="bold"
                    android:textColor="@color/white" android:alpha="0.85"/>
                <TextView android:id="@+id/tvSummaryCount" android:layout_width="wrap_content"
                    android:layout_height="wrap_content" android:text="0 টি"
                    android:textSize="18sp" android:textStyle="bold"
                    android:textColor="@color/white"
                    android:layout_marginTop="2dp"/>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <!-- Search Section -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginTop="12dp"
        android:layout_marginBottom="8dp" android:orientation="horizontal"
        android:gravity="center_vertical">

        <LinearLayout android:layout_width="0dp" android:layout_height="46dp"
            android:layout_weight="1" android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ie_search_bg"
            android:elevation="2dp"
            android:paddingStart="12dp" android:paddingEnd="8dp">

            <ImageView android:layout_width="18dp" android:layout_height="18dp"
                android:src="@drawable/ic_search" android:layout_marginEnd="8dp"/>

            <EditText android:id="@+id/etSearch"
                android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1"
                android:inputType="text" android:hint="খুঁজুন..."
                android:textSize="13.5sp" android:textStyle="bold"
                android:textColor="@color/ieDarkText"
                android:textColorHint="#9AA0A6"
                android:background="@android:color/transparent"
                android:singleLine="true" android:maxLines="1"
                android:imeOptions="actionSearch"
                android:cursorVisible="true"/>

            <ImageView android:id="@+id/ivClearSearch"
                android:layout_width="20dp" android:layout_height="20dp"
                android:src="@drawable/ic_clear" android:layout_marginStart="4dp"
                android:visibility="gone"
                android:alpha="0.6"
                android:padding="2dp"/>
        </LinearLayout>

        <ImageView android:id="@+id/btnSort" android:layout_width="46dp" android:layout_height="46dp"
            android:layout_marginStart="6dp" android:padding="10dp"
            android:src="@drawable/ic_sort" android:scaleType="centerInside"
            android:background="@drawable/ie_icon_btn_income"
            android:elevation="2dp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- View Mode Toggle & Chips Container -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginHorizontal="12dp" android:layout_marginBottom="8dp"
        android:orientation="vertical">

        <!-- View Toggle: Card/Table -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="44dp"
            android:orientation="horizontal"
            android:background="@drawable/ie_view_tab_track"
            android:elevation="2dp"
            android:padding="3dp"
            android:layout_marginBottom="8dp">

            <TextView android:id="@+id/btnViewCard" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:text="কার্ড ভিউ" android:gravity="center" android:textSize="12.5sp"
                android:textStyle="bold"
                android:clickable="true" android:focusable="true"/>

            <TextView android:id="@+id/btnViewTable" android:layout_width="0dp"
                android:layout_height="match_parent" android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="ছক ভিউ" android:gravity="center" android:textSize="12.5sp"
                android:textStyle="bold"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>
    </LinearLayout>

    <!-- Filter Chips -->
    <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:scrollbars="none" android:paddingHorizontal="12dp" android:layout_marginBottom="8dp">
        <LinearLayout android:id="@+id/chipRow" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:orientation="horizontal"/>
    </HorizontalScrollView>

    <!-- Card view -->
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvList"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:paddingHorizontal="12dp"
        android:paddingTop="4dp" android:paddingBottom="80dp" android:clipToPadding="false"
        android:overScrollMode="never"/>

    <!-- Table (ছক) view -->
    <ScrollView android:id="@+id/tableContainer" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:visibility="gone"
        android:overScrollMode="never"
        android:paddingHorizontal="12dp"
        android:clipToPadding="false">

        <LinearLayout android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginBottom="80dp">

            <include android:id="@+id/tableHeader" layout="@layout/item_transaction_table_header"/>

            <androidx.recyclerview.widget.RecyclerView android:id="@+id/rvTable"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_table_body"
                android:overScrollMode="never"
                android:nestedScrollingEnabled="false"/>
        </LinearLayout>
    </ScrollView>

    <!-- Empty State -->
    <LinearLayout android:id="@+id/emptyState" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1"
        android:orientation="vertical" android:gravity="center"
        android:visibility="gone">
        <ImageView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:src="@drawable/emoji_empty_mailbox" android:scaleType="centerInside" android:layout_marginBottom="12dp"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="কোনো তথ্য নেই" android:textSize="16sp"
            android:textColor="@color/textPrimary" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="উপরের বাটন থেকে যোগ করুন"
            android:textSize="13sp" android:textColor="@color/textSecondary"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>
