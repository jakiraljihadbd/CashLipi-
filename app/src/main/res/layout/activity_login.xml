<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loginCleanBg">

    <!-- ── Language toggle (top-right) ── -->
    <LinearLayout
        android:id="@+id/btnLanguageToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="18dp"
        android:layout_marginEnd="18dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/bg_login_lang_pill"
        android:paddingHorizontal="16dp"
        android:paddingVertical="9dp"
        android:clickable="true"
        android:focusable="true"
        android:elevation="2dp">

        <TextView
            android:id="@+id/tvCurrentLanguage"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="বাংলা" android:textSize="13.5sp" android:textStyle="bold"
            android:textColor="@color/loginCleanTextPrimary"
            android:layout_marginEnd="6dp"/>

        <ImageView
            android:layout_width="16dp" android:layout_height="16dp"
            android:src="@drawable/emoji_globe"
            android:contentDescription="@null"/>
    </LinearLayout>

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="30dp"
        android:paddingTop="36dp"
        android:paddingBottom="22dp">

        <!-- ── Logo Section ── -->
        <LinearLayout
            android:id="@+id/sectionLogo"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_horizontal|bottom"
            android:alpha="0">

            <!-- Logo (plain mark, no box/glow — matches reference) -->
            <ImageView
                android:layout_width="132dp" android:layout_height="132dp"
                android:layout_marginBottom="18dp"
                android:src="@drawable/logo_splash"
                android:scaleType="centerInside"/>

            <!-- স্বাগতম -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="স্বাগতম" android:textSize="19sp"
                android:textColor="@color/loginCleanTextSecondary" android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"/>

            <!-- App name, quoted -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="&#8220;ক্যাশলিপি&#8221;" android:textSize="32sp"
                android:textStyle="bold" android:textColor="@color/loginCleanTextPrimary"/>
        </LinearLayout>

        <!-- ── Login Section ── -->
        <LinearLayout
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0">

            <!-- Google Sign-In Button -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_login_btn_pill"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="16dp"
                android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="20dp" android:layout_height="20dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_google_logo"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="গুগল দিয়ে চালিয়ে যান"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/loginCleanTextPrimary"/>
            </LinearLayout>

            <!-- Email/Phone login button -->
            <LinearLayout
                android:id="@+id/btnEmailPhoneLogin"
                android:layout_width="match_parent" android:layout_height="60dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_login_btn_pill"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="22dp"
                android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="18dp" android:layout_height="18dp"
                    android:layout_marginEnd="10dp"
                    android:src="@drawable/ic_mail"
                    app:tint="@color/loginCleanTextPrimary"/>

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="ইমেইল দিয়ে চালিয়ে যান"
                    android:textSize="15sp" android:textStyle="bold"
                    android:textColor="@color/loginCleanTextPrimary"/>
            </LinearLayout>

            <!-- Terms + Privacy (green underlined links, set as spans in code) -->
            <TextView
                android:id="@+id/tvTermsPrivacy"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="চালিয়ে যাওয়ার মাধ্যমে আপনি আমাদের টার্মস ও কন্ডিশন এবং প্রাইভেসি পলিসি-তে সম্মত হচ্ছেন।"
                android:textSize="12sp" android:textColor="@color/loginCleanTextTertiary"
                android:gravity="center" android:lineSpacingExtra="3dp"/>

            <!-- পাসওয়ার্ড ভুলে গেছেন -->
            <TextView
                android:id="@+id/tvForgotPassword"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="পাসওয়ার্ড ভুলে গেছেন?"
                android:textSize="13sp" android:textStyle="bold"
                android:textColor="@color/loginLinkBlue"
                android:paddingTop="20dp" android:paddingBottom="4dp"
                android:clickable="true" android:focusable="true"/>

            <!-- Skip -->
            <TextView
                android:id="@+id/tvSkipLogin"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:text="লগইন ছাড়াই এগিয়ে যান"
                android:textSize="12.5sp"
                android:textColor="@color/loginCleanTextTertiary"
                android:paddingTop="14dp"
                android:clickable="true" android:focusable="true"/>
        </LinearLayout>

    </LinearLayout>

    <!-- Loading overlay -->
    <FrameLayout android:id="@+id/loadingOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#80000000" android:visibility="gone"
        android:clickable="true" android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
            <ProgressBar android:layout_width="48dp" android:layout_height="48dp"
                android:indeterminateTint="@color/colorPrimary" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="সাইন ইন হচ্ছে..." android:textSize="13sp" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
