<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/loginCleanBg">

    <!-- Main content -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingHorizontal="30dp"
        android:paddingTop="36dp"
        android:paddingBottom="22dp">

        <!-- ── Logo Section ── -->
        <LinearLayout
            android:id="@+id/sectionLogo"
            android:layout_width="wrap_content"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:alpha="0">

            <!-- Logo -->
            <FrameLayout
                android:layout_width="88dp"
                android:layout_height="88dp"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_login_logo_box">
                <ImageView android:layout_width="54dp" android:layout_height="54dp"
                    android:layout_gravity="center"
                    android:src="@drawable/logo_splash"
                    android:scaleType="centerInside"/>
            </FrameLayout>

            <!-- স্বাগতম -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="স্বাগতম" android:textSize="14sp"
                android:textColor="@color/loginCleanTextSecondary" android:letterSpacing="0.06"
                android:layout_marginBottom="6dp"/>

            <!-- App name -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="CashLipi ক্যাশলিপি" android:textSize="27sp"
                android:textStyle="bold" android:textColor="@color/loginCleanTextPrimary"
                android:layout_marginBottom="8dp"/>

            <!-- Tagline -->
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="আপনার প্রতিদিনের হিসাব — সহজ ও নিরাপদ"
                android:textSize="13sp" android:textColor="@color/loginCleanTextSecondary"
                android:gravity="center"/>
        </LinearLayout>

        <!-- ── Login Section ── -->
        <LinearLayout
            android:id="@+id/cardLogin"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:alpha="0">

            <!-- Email/Phone login button -->
            <LinearLayout
                android:id="@+id/btnEmailPhoneLogin"
                android:layout_width="match_parent" android:layout_height="58dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_login_btn_clean"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:clickable="true" android:focusable="true">

                <TextView android:layout_width="24dp" android:layout_height="wrap_content"
                    android:text="✉️" android:textSize="17sp" android:gravity="start"/>

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:text="Email / Phone দিয়ে চালিয়ে যান"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/loginCleanTextPrimary"/>

                <View android:layout_width="24dp" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Google Sign-In Button -->
            <LinearLayout
                android:id="@+id/btnGoogleSignIn"
                android:layout_width="match_parent" android:layout_height="58dp"
                android:orientation="horizontal" android:gravity="center_vertical"
                android:background="@drawable/bg_login_btn_clean"
                android:paddingHorizontal="20dp"
                android:layout_marginBottom="14dp"
                android:clickable="true" android:focusable="true">

                <ImageView android:layout_width="22dp" android:layout_height="22dp"
                    android:src="@drawable/ic_google_logo"/>

                <TextView android:layout_width="0dp" android:layout_height="wrap_content"
                    android:layout_weight="1" android:gravity="center"
                    android:text="Google দিয়ে চালিয়ে যান"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/loginCleanTextPrimary"/>

                <View android:layout_width="22dp" android:layout_height="wrap_content"/>
            </LinearLayout>

            <!-- Skip Button -->
            <LinearLayout
                android:id="@+id/btnSkipLogin"
                android:layout_width="match_parent" android:layout_height="58dp"
                android:orientation="horizontal" android:gravity="center"
                android:background="@drawable/bg_login_btn_skip_clean"
                android:layout_marginBottom="22dp"
                android:clickable="true" android:focusable="true">

                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:text="☁️  লগইন ছাড়াই ব্যবহার করুন"
                    android:textSize="14sp" android:textStyle="bold"
                    android:textColor="@color/loginCleanTextPrimary"/>
            </LinearLayout>

            <!-- Info caption (no box, minimal) -->
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Google দিয়ে লগইন করলে ডেটা ক্লাউডে ব্যাকআপ হবে ও যেকোনো ডিভাইসে ফিরিয়ে আনা যাবে"
                android:textSize="11.5sp" android:textColor="@color/loginCleanTextTertiary"
                android:gravity="center" android:lineSpacingExtra="2dp"/>
        </LinearLayout>

        <!-- Privacy note -->
        <TextView
            android:id="@+id/tvPrivacyNote"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="সাইন ইন করে আপনি Privacy Policy-তে সম্মত হচ্ছেন"
            android:textSize="11sp" android:textColor="@color/loginCleanTextTertiary"
            android:gravity="center" android:layout_marginTop="18dp"/>

    </LinearLayout>

    <!-- Loading overlay -->
    <FrameLayout android:id="@+id/loadingOverlay"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#80000000" android:visibility="gone"
        android:clickable="true" android:gravity="center">
        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical" android:gravity="center">
            <ProgressBar android:layout_width="48dp" android:layout_height="48dp"
                android:indeterminateTint="@color/colorPrimary" android:layout_marginBottom="12dp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="সাইন ইন হচ্ছে..." android:textSize="13sp" android:textColor="#FFFFFF"/>
        </LinearLayout>
    </FrameLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
