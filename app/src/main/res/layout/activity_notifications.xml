<?xml version="1.0" encoding="utf-8"?>
<!--
  activity_notifications — অ্যাডমিন অ্যাপ থেকে পাঠানো নোটিফিকেশন/ঘোষণা/ফোর্স-আপডেট/মেইনটেন্যান্স/নোটিশ
  এখানে ইতিহাস আকারে দেখা যায় (বেল আইকনে ট্যাপ করলে খোলে)।
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@color/bgColor">

    <!-- ── Header — ব্যালেন্স কার্ডের রঙে, ব্যাক + টাইটেল + সব পড়া হয়েছে ── -->
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical"
        android:background="@drawable/bg_header_generic"
        android:paddingHorizontal="10dp"
        android:paddingTop="14dp" android:paddingBottom="16dp"
        android:elevation="4dp">

        <ImageView android:id="@+id/btnNotifBack"
            android:layout_width="40dp" android:layout_height="40dp"
            android:background="@drawable/bg_ai_icon_btn_circle"
            android:src="@drawable/ic_arrow_back"
            android:padding="9dp"
            android:contentDescription="ফিরে যান"/>

        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="10dp"
            android:text="🔔 নোটিফিকেশন"
            android:textSize="18sp" android:textStyle="bold" android:textColor="@color/white"/>

        <TextView android:id="@+id/btnMarkAllRead"
            android:layout_width="wrap_content" android:layout_height="36dp"
            android:text="সব পড়া হয়েছে"
            android:textSize="11.5sp" android:textStyle="bold" android:textColor="@color/white"
            android:background="@drawable/bg_header_glass_pill"
            android:gravity="center"
            android:paddingHorizontal="12dp"
            android:clickable="true" android:focusable="true"/>
    </LinearLayout>

    <!-- ── লিস্ট ── -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvNotifications"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:clipToPadding="false"
        android:paddingBottom="16dp"
        android:overScrollMode="never"/>

    <!-- ── খালি অবস্থা ── -->
    <LinearLayout android:id="@+id/emptyNotifState"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical" android:gravity="center"
        android:visibility="gone">
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="🔕"
            android:textSize="48sp"
            android:layout_marginBottom="10dp"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="কোনো নোটিফিকেশন নেই"
            android:textSize="16sp" android:textStyle="bold"
            android:textColor="@color/textSecondary"/>
        <TextView
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="নতুন নোটিফিকেশন এলে এখানে দেখা যাবে"
            android:textSize="12sp" android:textColor="@color/textHint"
            android:layout_marginTop="6dp"/>
    </LinearLayout>
</LinearLayout>
