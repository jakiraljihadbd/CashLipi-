<?xml version="1.0" encoding="utf-8"?>
<!-- প্রোফাইল পেজ থেকে লগ আউট কনফার্মেশন — আইকন ব্যাজ + টাইটেল + সাব-টেক্সট -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/cardBg"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="30dp"
    android:paddingBottom="8dp"
    android:gravity="center_horizontal">

    <FrameLayout
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:background="@drawable/bg_danger_icon_circle">

        <ImageView
            android:layout_width="28dp"
            android:layout_height="28dp"
            android:layout_gravity="center"
            android:src="@drawable/ic_logout"
            app:tint="@color/expenseColor"
            android:contentDescription="@null"/>
    </FrameLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:text="লগ আউট করবেন?"
        android:textColor="@color/textPrimary"
        android:textSize="19sp"
        android:textStyle="bold"
        android:gravity="center"/>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="আপনার লোকাল ডেটা মুছে যাবে না। আবার সাইন-ইন করলে সব ফিরে পাবেন।"
        android:textColor="@color/textSecondary"
        android:textSize="14sp"
        android:lineSpacingExtra="3dp"
        android:gravity="center"/>

</LinearLayout>
