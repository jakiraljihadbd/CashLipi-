<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ieGreyBg">

    <LinearLayout
        android:id="@+id/contentColumn"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <!-- ===== চিকন এন্ট্রি-কাউন্ট স্ট্রিপ (টগলের জায়গায়, হালকা) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="14dp"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="সঞ্চয় হিসাব"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/ieDarkText"
                android:alpha="0.55"/>

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"/>

            <TextView
                android:id="@+id/tvSummaryCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0 টি এন্ট্রি"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:textColor="@color/iePinkText"/>
        </LinearLayout>

        <!-- ===== মোট সঞ্চয় — কমপ্যাক্ট, পিংক থিম ===== -->
        <LinearLayout
            android:id="@+id/totalSavingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="7dp"
            android:background="@drawable/ie_summary_bg_pink">

            <ImageView
                android:layout_width="32dp"
                android:layout_height="32dp"
                android:padding="6dp"
                android:src="@drawable/ic_nav_savings"
                android:scaleType="centerInside"
                android:background="@drawable/ie_summary_icon_income"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="10dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="মোট সঞ্চয়"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:textColor="@color/iePinkText"
                    android:alpha="0.85"/>

                <TextView
                    android:id="@+id/tvSummaryTotal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="1dp"
                    android:text="৳ 0"
                    android:textSize="19sp"
                    android:textStyle="bold"
                    android:textColor="@color/iePinkText"/>
            </LinearLayout>
        </LinearLayout>

        <!-- ===== সার্চ + সর্ট (স্কয়ার, পিংক) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/ie_search_bg"
                android:elevation="3dp"
                android:paddingStart="14dp"
                android:paddingEnd="8dp">

                <ImageView
                    android:layout_width="19dp"
                    android:layout_height="19dp"
                    android:src="@drawable/ic_search"
                    android:layout_marginEnd="8dp"/>

                <EditText
                    android:id="@+id/etSearch"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:inputType="text"
                    android:hint="খুঁজুন..."
                    android:textSize="13.5sp"
                    android:textStyle="bold"
                    android:textColor="@color/ieDarkText"
                    android:textColorHint="#9AA0A6"
                    android:background="@android:color/transparent"
                    android:singleLine="true"
                    android:maxLines="1"
                    android:imeOptions="actionSearch"/>

                <ImageView
                    android:id="@+id/ivClearSearch"
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/ic_clear"
                    android:layout_marginStart="4dp"
                    android:visibility="gone"
                    android:alpha="0.6"/>
            </LinearLayout>

            <ImageView
                android:id="@+id/btnSort"
                android:layout_width="46dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:padding="11dp"
                android:src="@drawable/ic_sort"
                android:scaleType="centerInside"
                app:tint="@color/ieWhite"
                android:background="@drawable/ie_icon_btn_pink"
                android:elevation="3dp"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- ===== ভিউ সুইচার: কার্ড / ছক (পিংক সিলেক্টেড) ===== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="10dp"
            android:orientation="horizontal"
            android:background="@drawable/ie_view_tab_track"
            android:elevation="2dp"
            android:padding="3dp">

            <TextView
                android:id="@+id/btnViewCard"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="কার্ড ভিউ"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>

            <TextView
                android:id="@+id/btnViewTable"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="3dp"
                android:text="ছক ভিউ"
                android:gravity="center"
                android:textSize="12.5sp"
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"/>
        </LinearLayout>

        <!-- ===== ফিল্টার চিপস (সময় অনুযায়ী) ===== -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:scrollbars="none"
            android:paddingHorizontal="12dp"
            android:layout_marginBottom="8dp">
            <LinearLayout
                android:id="@+id/chipRow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"/>
        </HorizontalScrollView>

        <!-- Card view -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingHorizontal="12dp"
            android:paddingTop="2dp"
            android:paddingBottom="80dp"
            android:clipToPadding="false"
            android:overScrollMode="never"/>

        <!-- Table (ছক) view -->
        <ScrollView
            android:id="@+id/tableContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone"
            android:overScrollMode="never"
            android:paddingHorizontal="12dp"
            android:clipToPadding="false">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="80dp">

                <include android:id="@+id/tableHeader" layout="@layout/item_transaction_table_header"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTable"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_table_body"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"/>
            </LinearLayout>
        </ScrollView>

        <!-- Empty State -->
        <LinearLayout
            android:id="@+id/emptyState"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">
            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/emoji_empty_mailbox"
                android:scaleType="centerInside"
                android:layout_marginBottom="12dp"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="কোনো তথ্য নেই"
                android:textSize="16sp"
                android:textColor="@color/ieDarkText"
                android:textStyle="bold"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="নিচের বাটন থেকে যোগ করুন"
                android:textSize="13sp"
                android:textColor="@color/ieDarkText"
                android:alpha="0.6"
                android:layout_marginTop="6dp"/>
        </LinearLayout>
    </LinearLayout>

    <!-- ===== ফ্লোটিং অ্যাড বাটন — পিংক ===== -->
    <LinearLayout
        android:id="@+id/btnAddNew"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:background="@drawable/ie_fab_pink"
        android:gravity="center"
        android:elevation="10dp"
        android:clickable="true"
        android:focusable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginBottom="22dp"
        android:layout_marginEnd="18dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="@color/ieWhite"/>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
